{
  "name": "@adatechnology/audio-transcription-mcp",
  "version": "0.1.0-rc.1",
  "description": "MCP server exposing local Whisper transcription (whisper.cpp) as a tool — no API key, no upload",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "audio-transcription-mcp": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "prepack": "bun run build",
    "start": "bun src/main.ts",
    "test": "bun test",
    "format": "prettier --write package.json src tsconfig.json tsup.config.ts",
    "format:check": "prettier --check package.json src tsconfig.json tsup.config.ts"
  },
  "keywords": [
    "mcp",
    "transcription",
    "whisper",
    "speech-to-text",
    "pt-br"
  ],
  "author": "Ada Technology",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@adatechnology/audio-transcription-provider": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
