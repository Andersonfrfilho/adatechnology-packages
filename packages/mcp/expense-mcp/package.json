{
  "name": "@adatechnology/expense-mcp",
  "version": "0.1.0",
  "description": "MCP server for accounts payable (bills, due dates, settlements) over any API that exposes the @adatechnology/expense-module routes",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "expense-mcp": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "prepack": "bun run build",
    "start": "bun src/main.ts",
    "test": "bun test"
  },
  "keywords": [
    "mcp",
    "expenses",
    "accounts-payable",
    "contas-a-pagar",
    "pt-br"
  ],
  "author": "Ada Technology",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@adatechnology/expense-contracts": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
