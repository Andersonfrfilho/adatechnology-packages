{
  "name": "@adatechnology/infra-module",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Railway infrastructure management as a pluggable module — environment power on/off, schedules, costs and encrypted token integration behind ports",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist",
    "src/migrations"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@adatechnology/infra-contracts": "workspace:*",
    "zod": "^3.24.1",
    "@adatechnology/module-http": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "drizzle-orm": "0.45.2",
    "drizzle-kit": "0.31.10"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0 <1"
  }
}
