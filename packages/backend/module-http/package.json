{
  "name": "@adatechnology/module-http",
  "version": "0.1.0-rc.3",
  "license": "MIT",
  "description": "Framework-agnostic HTTP layer for pluggable modules — declarative route table, fetch and uWebSockets adapters, OpenAPI generation",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js",
      "require": "./dist/fetch.cjs"
    },
    "./uws": {
      "types": "./dist/uws.d.ts",
      "import": "./dist/uws.js",
      "require": "./dist/uws.cjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js",
      "require": "./dist/openapi.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "typesVersions": {
    "*": {
      "fetch": [
        "dist/fetch.d.ts"
      ],
      "uws": [
        "dist/uws.d.ts"
      ],
      "openapi": [
        "dist/openapi.d.ts"
      ],
      "testing": [
        "dist/testing/index.d.ts"
      ]
    }
  }
}
