{
  "name": "@adatechnology/opendelivery-marketplace-provider",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open Delivery (Abrasel) connector for @adatechnology/marketplace-contracts: OAuth client credentials, events polling with acknowledgment, order details, status actions, cancellation and webhook HMAC check. Works with any platform on the standard.",
  "keywords": [
    "open-delivery",
    "abrasel",
    "marketplace",
    "delivery",
    "pos"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adatechnology/marketplace-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
