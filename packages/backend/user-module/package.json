{
  "name": "@adatechnology/user-module",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Stateful user/authentication module — schema, migrations, repositories and use-cases behind pluggable auth providers",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    },
    "./http/fetch": {
      "types": "./dist/http/fetch.d.ts",
      "import": "./dist/http/fetch.js",
      "require": "./dist/http/fetch.cjs"
    },
    "./http/uws": {
      "types": "./dist/http/uws.d.ts",
      "import": "./dist/http/uws.js",
      "require": "./dist/http/uws.cjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js",
      "require": "./dist/openapi.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "schema": [
        "dist/schema/index.d.ts"
      ],
      "http/fetch": [
        "dist/http/fetch.d.ts"
      ],
      "http/uws": [
        "dist/http/uws.d.ts"
      ],
      "openapi": [
        "dist/openapi.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@adatechnology/user-contracts": "workspace:*",
    "@adatechnology/module-http": "workspace:*",
    "zod": "^3.24.1",
    "jose": "^5.9.6"
  },
  "optionalDependencies": {
    "@adatechnology/auth-keycloak": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0 <2"
  }
}
