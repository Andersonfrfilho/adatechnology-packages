{
  "name": "@adatechnology/expense-contracts",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Accounts payable (fixed and variable expenses) domain: types, pure rules for due dates, installments, amount history, cost allocation, forecast, out-of-pattern alerts, due reminders and the chat (WhatsApp) flow to register an expense. No I/O.",
  "keywords": [
    "expenses",
    "accounts-payable",
    "contas-a-pagar",
    "finance",
    "whatsapp",
    "pt-br"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
