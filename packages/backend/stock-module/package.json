{
  "name": "@adatechnology/stock-module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Optional stateful stock module — levels per ingredient with minimum and alert hook, batches with expiry and expiry scan job, movements (in/out/adjust/loss) with reason and actor, idempotent deduction per order line through recipes (FEFO), inventory count sessions; implements recipe-module StockLevelPort; enabled per company; schema, migrations and module-http routes",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http/fetch": {
      "types": "./dist/http/fetch.d.ts",
      "import": "./dist/http/fetch.js",
      "require": "./dist/http/fetch.cjs"
    },
    "./http/uws": {
      "types": "./dist/http/uws.d.ts",
      "import": "./dist/http/uws.js",
      "require": "./dist/http/uws.cjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js",
      "require": "./dist/openapi.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@adatechnology/module-http": "workspace:*",
    "@adatechnology/recipe-contracts": "workspace:*",
    "@adatechnology/stock-contracts": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0 <1"
  }
}
