{
  "name": "@adatechnology/text-moderation",
  "version": "0.1.0",
  "description": "Offensive language detection for pt-BR conversational products, extensible by the host",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "keywords": [
    "profanity",
    "moderation",
    "pt-br",
    "whatsapp",
    "content-moderation"
  ],
  "author": "Ada Technology",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
