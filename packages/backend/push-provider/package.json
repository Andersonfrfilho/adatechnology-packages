{
  "name": "@adatechnology/push-provider",
  "version": "0.1.0-rc.6",
  "description": "Stateless push notification providers (Expo, FCM) behind a single port — part of the notification trio",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adatechnology/notification-contracts": "workspace:*"
  },
  "peerDependencies": {
    "firebase-admin": ">=12 <14"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "firebase-admin": "^13.7.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
