{
  "name": "@adatechnology/microsoft-calendar-provider",
  "version": "0.1.0",
  "description": "CalendarSyncPort backed by the Microsoft Graph API v1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "prepack": "bun run build",
    "test": "bun test",
    "format": "prettier --write package.json src tsconfig.json tsup.config.ts",
    "format:check": "prettier --check package.json src tsconfig.json tsup.config.ts"
  },
  "keywords": [
    "bun",
    "microsoft-graph",
    "outlook",
    "calendar-sync"
  ],
  "author": "Ada Technology",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@adatechnology/scheduling-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
