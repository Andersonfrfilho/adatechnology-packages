      "policies": {},
      "checkConstraints": {
        "messages_channel_check": {
          "name": "messages_channel_check",
          "value": "\"conversation\".\"messages\".\"channel\" in ('email', 'whatsapp', 'app', 'portal', 'webchat')"
        },
        "messages_direction_check": {
          "name": "messages_direction_check",
          "value": "\"conversation\".\"messages\".\"direction\" in ('inbound', 'outbound')"
        },
        "messages_author_check": {
          "name": "messages_author_check",
          "value": "(\"conversation\".\"messages\".\"direction\" = 'outbound' and (\"conversation\".\"messages\".\"author_user_id\" is not null) <> \"conversation\".\"messages\".\"automatic\" and \"conversation\".\"messages\".\"sender_address\" is null)\n        or (\"conversation\".\"messages\".\"direction\" = 'inbound' and not \"conversation\".\"messages\".\"automatic\" and num_nonnulls(\"conversation\".\"messages\".\"author_user_id\", \"conversation\".\"messages\".\"sender_address\") = 1\n          and (\"conversation\".\"messages\".\"author_user_id\" is null or \"conversation\".\"messages\".\"channel\" in ('app', 'portal', 'webchat'))\n          and (\"conversation\".\"messages\".\"sender_address\" is null or \"conversation\".\"messages\".\"channel\" in ('email', 'whatsapp', 'webchat')))"
        },
        "messages_status_check": {
          "name": "messages_status_check",
          "value": "\"conversation\".\"messages\".\"status\" is null or \"conversation\".\"messages\".\"status\" in ('queued', 'sent', 'delivered', 'read', 'failed', 'bounced')"
        },
        "messages_status_direction_check": {
          "name": "messages_status_direction_check",
          "value": "(\"conversation\".\"messages\".\"direction\" = 'outbound') = (\"conversation\".\"messages\".\"status\" is not null)"
        },
        "messages_dkim_result_check": {
          "name": "messages_dkim_result_check",
          "value": "\"conversation\".\"messages\".\"dkim_result\" is null or (\"conversation\".\"messages\".\"dkim_result\" in ('aligned', 'not_aligned', 'unverifiable', 'absent') and \"conversation\".\"messages\".\"channel\" = 'email' and \"conversation\".\"messages\".\"direction\" = 'inbound')"
        },
        "messages_body_length_check": {
          "name": "messages_body_length_check",
          "value": "length(\"conversation\".\"messages\".\"body_text\") <= 8000"
        },
        "messages_email_reachable_status_check": {
          "name": "messages_email_reachable_status_check",
          "value": "\"conversation\".\"messages\".\"channel\" <> 'email' or \"conversation\".\"messages\".\"status\" is null or \"conversation\".\"messages\".\"status\" in ('queued', 'sent', 'delivered', 'failed', 'bounced')"
        },
        "messages_whatsapp_reachable_status_check": {
          "name": "messages_whatsapp_reachable_status_check",
          "value": "\"conversation\".\"messages\".\"channel\" <> 'whatsapp' or \"conversation\".\"messages\".\"status\" is null or \"conversation\".\"messages\".\"status\" in ('queued', 'sent', 'delivered', 'read', 'failed')"
        },
        "messages_app_reachable_status_check": {
          "name": "messages_app_reachable_status_check",
          "value": "\"conversation\".\"messages\".\"channel\" <> 'app' or \"conversation\".\"messages\".\"status\" is null or \"conversation\".\"messages\".\"status\" in ('queued', 'delivered', 'read')"
        },
        "messages_portal_reachable_status_check": {
          "name": "messages_portal_reachable_status_check",
          "value": "\"conversation\".\"messages\".\"channel\" <> 'portal' or \"conversation\".\"messages\".\"status\" is null or \"conversation\".\"messages\".\"status\" in ('delivered', 'read')"
        },
        "messages_webchat_reachable_status_check": {
          "name": "messages_webchat_reachable_status_check",
          "value": "\"conversation\".\"messages\".\"channel\" <> 'webchat' or \"conversation\".\"messages\".\"status\" is null or \"conversation\".\"messages\".\"status\" in ('queued', 'delivered', 'failed')"
        }
