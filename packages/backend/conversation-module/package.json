{
  "name": "@adatechnology/conversation-module",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Conversation core — schema, migrations, use-cases and generic assignment behind pluggable ports (channel-agnostic, subject-agnostic)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@adatechnology/conversation-contracts": "workspace:*",
    "mailauth": "5.0.3",
    "postal-mime": "^2.7.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0 <2"
  }
}
