{
  "name": "@adatechnology/mercadopago-payment-provider",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Mercado Pago plugin for the payment trio: Pix (QR + copia-e-cola) and card payment links per account, webhook with x-signature HMAC check, normalized payment events",
  "keywords": [
    "mercadopago",
    "mercado-pago",
    "pix",
    "payment",
    "webhook",
    "brasil"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adatechnology/payment-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
