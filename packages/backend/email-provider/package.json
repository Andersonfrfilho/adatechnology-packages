{
  "name": "@adatechnology/email-provider",
  "version": "0.1.0-rc.7",
  "description": "Stateless email providers (SMTP, Resend, SES) behind a single port — part of the notification trio",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adatechnology/notification-contracts": "workspace:*"
  },
  "peerDependencies": {
    "nodemailer": ">=6.9.0 <10",
    "resend": ">=4 <7",
    "@aws-sdk/client-sesv2": ">=3 <4"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    },
    "resend": {
      "optional": true
    },
    "@aws-sdk/client-sesv2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "3.1091.0",
    "@types/bun": "1.3.14",
    "@types/nodemailer": "^7.0.2",
    "nodemailer": "^9.0.1",
    "resend": "^6.17.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
