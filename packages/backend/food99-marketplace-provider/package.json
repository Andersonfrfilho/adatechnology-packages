{
  "name": "@adatechnology/food99-marketplace-provider",
  "version": "0.0.0",
  "license": "MIT",
  "description": "99Food native protocol connector for @adatechnology/marketplace-contracts: signed webhook, per-shop token, 64-bit ids, order details in cents, status actions, cancellation, refund/cancel requests and financial bills.",
  "keywords": [
    "99food",
    "marketplace",
    "delivery",
    "pos"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adatechnology/marketplace-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
