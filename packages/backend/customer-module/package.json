{
  "name": "@adatechnology/customer-module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Stateful customer registry \u2014 schema, migrations, repositories and use-cases behind a declared field catalog",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "schema": [
        "dist/schema/index.d.ts"
      ],
      "http/fetch": [
        "dist/http/fetch.d.ts"
      ],
      "http/uws": [
        "dist/http/uws.d.ts"
      ],
      "openapi": [
        "dist/openapi.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@adatechnology/module-http": "workspace:*",
    "zod": "^3.24.1",
    "@adatechnology/customer-contracts": "workspace:*"
  },
  "optionalDependencies": {
    "@adatechnology/auth-keycloak": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0 <2"
  }
}
