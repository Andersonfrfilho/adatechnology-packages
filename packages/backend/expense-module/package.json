{
  "name": "@adatechnology/expense-module",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Stateful accounts-payable module (bills, recurring expenses, due dates, settlements) — schema, migrations, use-cases and HTTP routes",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    },
    "./http/fetch": {
      "types": "./dist/http/fetch.d.ts",
      "import": "./dist/http/fetch.js",
      "require": "./dist/http/fetch.cjs"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js",
      "require": "./dist/openapi.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "schema": [
        "dist/schema/index.d.ts"
      ],
      "http/fetch": [
        "dist/http/fetch.d.ts"
      ],
      "openapi": [
        "dist/openapi.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@adatechnology/expense-contracts": "workspace:*",
    "@adatechnology/module-http": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0 <1"
  }
}
