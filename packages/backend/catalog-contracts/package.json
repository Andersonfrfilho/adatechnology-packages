{
  "name": "@adatechnology/catalog-contracts",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shared types, zod schemas and port interfaces for the catalog trio (contracts only — no runtime behavior)",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  }
}
