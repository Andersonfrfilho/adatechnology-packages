{
  "name": "@adatechnology/products-ui",
  "version": "0.1.0-rc.7",
  "description": "Product & catalog management UI components — parametrizável por API client injetado",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm --external react --external react-dom",
    "build:watch": "tsup src/index.ts --watch --dts --format esm --external react --external react-dom",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "lucide-react": "^1.21.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
