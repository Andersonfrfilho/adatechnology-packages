{
  "name": "@adatechnology/recipes-ui",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Recipe costing UI (ficha técnica) — IngredientsWorkspace (search, unit filter, sort, server pagination, total, CSV/XLSX export, create/edit/delete), RecipeEditor with live cost and margin, RecipeCostSummary and ShoppingListWorkspace; headless hooks; API injected, no native controls, themable tokens",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adatechnology/recipe-contracts": "workspace:*",
    "lucide-react": "^1.21.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
