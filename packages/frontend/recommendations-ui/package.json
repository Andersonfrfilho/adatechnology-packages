{
  "name": "@adatechnology/recommendations-ui",
  "version": "0.1.0",
  "description": "Recommendation UI — feed com rótulo de patrocinado e rastreio de impressão/clique, e a administração de itens, campanhas e métricas, parametrizável por API client injetado",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm --external react --external react-dom",
    "build:watch": "tsup src/index.ts --watch --dts --format esm --external react --external react-dom",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
