<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Stone's filters declare a host, so a scheme-only query does not make them visible on Android 11+. -->
    <queries>
        <package android:name="br.com.stone.posandroid.acquirerapp" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="payment-app" android:host="pay" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="cancel-app" android:host="cancel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="printer-app" android:host="print" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".StonePendingService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
