{
  "name": "@adatechnology/stone-pos",
  "version": "0.1.0",
  "description": "Stone POS integration for React Native (Android): payment, cancellation and receipt printing through the Stone deeplinks",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "android",
    "!src/__tests__",
    "!android/build",
    "!android/src/test"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --clean --format esm,cjs --external react-native",
    "build:watch": "tsup src/index.ts --watch --dts --format esm,cjs --external react-native",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "codegenConfig": {
    "name": "NativeStonePosSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "br.com.adatechnology.stonepos"
    }
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^19",
    "react-native": ">=0.80"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
