{
  "name": "@adatechnology/site-preview-ui",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Prévia ao vivo do site dentro do painel: iframe em escala (Computador/Tablet/Celular, zoom, mão, expandir), protocolo postMessage que rola até a seção em edição e a destaca, rolagem guardada entre recargas e o lado do site (guest) sem framework",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guest": {
      "types": "./dist/guest/index.d.ts",
      "import": "./dist/guest/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
