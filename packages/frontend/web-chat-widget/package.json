{
  "name": "@adatechnology/web-chat-widget",
  "version": "0.1.0-rc.3",
  "description": "Chat de site como Web Component nativo — sem framework, plugável em qualquer página",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./simulator": {
      "import": "./dist/simulator/index.js",
      "types": "./dist/simulator/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/simulator/index.ts --dts --clean --format esm",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
