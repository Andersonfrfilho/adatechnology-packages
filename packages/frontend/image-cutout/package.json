{
  "name": "@adatechnology/image-cutout",
  "version": "0.0.0",
  "description": "Recorte de fundo no navegador (U²-Net sobre onnxruntime-web), sem CDN e sem licença viral",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm --external react --external react-dom",
    "build:watch": "tsup src/index.ts --watch --dts --format esm --external react --external react-dom",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^18 || ^19",
    "@types/react-dom": "^18 || ^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
