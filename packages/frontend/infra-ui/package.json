{
  "name": "@adatechnology/infra-ui",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Infra UI — headless hooks + gestão de ambientes, custos e integração de provedor de infraestrutura em nuvem",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm --external react --external react-dom --external @tanstack/react-query",
    "build:watch": "tsup src/index.ts --watch --dts --format esm --external react --external react-dom --external @tanstack/react-query",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@adatechnology/infra-contracts": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.62.8",
    "@types/bun": "1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
